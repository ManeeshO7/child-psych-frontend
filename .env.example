# Backend API (used by Next.js rewrites to proxy /api to backend)
BACKEND_URL=http://localhost:8000

# Stripe (for save card on file). Get from https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps (for California-only address autocomplete on pre-screening questionnaire). Enable Places API and create an API key at https://console.cloud.google.com/
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here
