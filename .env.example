# Backend API (used by Next.js rewrites to proxy /api to backend)
BACKEND_URL=http://localhost:8000

# Stripe (for save card on file). Get from https://dashboard.stripe.com/apikeys
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Google Maps (for California-only address autocomplete on pre-screening questionnaire).
# Enable in Google Cloud Console: "Maps JavaScript API" and "Places API (New)".
# Create an API key at https://console.cloud.google.com/apis/credentials
# If restricting the key: allow HTTP referrers (e.g. http://localhost:3000/*) for your domain.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_key_here
